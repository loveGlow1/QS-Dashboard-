# Supabase — the publishable key is designed to ship in the browser and grants
# nothing on its own. Every table is behind row level security.
NEXT_PUBLIC_SUPABASE_URL=https://ihbwmebrflqkpchiqbpu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Vkvk3jTSPh1zGlmmNVs50Q_E-3qLzJW

# Server only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
#
# The app itself does not need this: a customer declares a deposit through
# their own session, and settling one happens in the database. It is here for
# operator tooling — settle_deposit, reject_deposit, and managing the address
# pool — which runs as the service role.
SUPABASE_SERVICE_ROLE_KEY=
